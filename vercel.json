{
  "version": 2,
  "buildCommand": "npm --prefix server run build && npm --prefix mobile-web run build",
  "outputDirectory": "mobile-web/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
